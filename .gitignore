# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/
.coverage
htmlcov/

# Secrets and machine-specific configuration
.env
.env.*
!.env.example
.vercel/
.kilo/
.vscode/
.DS_Store
Thumbs.db

# Rebuildable snapshots and publish output (public/assets stays source-controlled)
/data/
/deploy/
/public/*.html
# Google Search Console (and similar) ownership files must ship as real assets
!/public/google*.html
/public/build-manifest.json
# The record layer is generated from the stores every edition (registre / substrate)
/public/registre/
/public/delta/
/public/llms.txt
/public/index.html.md
/public/dossiers/
/public/methode/
/public/memoire/
# The event surfaces (scripts/evenements.py, behind scripts/surfaces.py): their
# current pages carry publisher text, which the public repo never holds
/public/evenements/
/public/en/
/public/qualite.json

# Historical one-off patch scripts and execution logs
/_*.py
/_*.txt
/firebase-debug.log

# Throwaway browser profiles and dev-server pid files. A stray `git stash -u`
# once captured a whole Edge profile (455 MB of cookies and history) from here.
/.tmp-*/
/.ui-server.pid
/.vigie-serve.pid

# Isolated agent worktrees (Claude Code) live inside the checkout
/.claude/

.vercel
.env*
